# Secrets - never commit
.env
*.pem

# Raw data: not redistributed (check the dataset licence; download it yourself, see README)
data/raw/*
!data/raw/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Model artifacts and local caches; small metrics/reports in results/ are intentionally tracked.
*.joblib
*.pkl
artifacts/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Locally generated feature extracts are reproducible from the raw data.
data/derived/*
!data/derived/.gitkeep

# Local batch scores depend on private/current operational inputs; regenerate when needed.
results/dispatch_scored_orders.csv
